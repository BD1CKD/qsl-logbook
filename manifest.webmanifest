{
  "id": "./",
  "name": "QSL LOGBOOK · 离线卡片管理",
  "short_name": "QSL Log",
  "description": "离线优先的 QSL 卡片与通联日志管理，记录发卡日期、收发状态，支持导入导出备份。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0d10",
  "theme_color": "#0a0d10",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "新建主记录",
      "short_name": "新建记录",
      "description": "记录一条已发卡的通联",
      "url": "./?action=add-main",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "新建计划记录",
      "short_name": "计划中",
      "description": "先记录通联，等待发卡",
      "url": "./?action=add-planned",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "备份与导入",
      "short_name": "备份",
      "description": "导出或导入本机日志",
      "url": "./?action=backup",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
